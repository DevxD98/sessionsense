<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: lets adb point the updater at a test release (see RELEASING.md). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver android:name=".UpdateDebugReceiver" android:exported="true">
            <intent-filter><action android:name="com.sessionsense.DEBUG_UPDATE_MANIFEST" /></intent-filter>
        </receiver>
    </application>
</manifest>
