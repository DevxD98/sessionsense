<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="13dp">

    <!-- Header: SESSION label + live dot -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="SESSION"
            android:textColor="#52F2F2F3"
            android:textSize="7.5sp"
            android:letterSpacing="0.12"
            android:fontFamily="sans-serif-medium" />

        <ImageView
            android:id="@+id/widget_live_dot"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:background="@drawable/widget_dot_live" />

    </LinearLayout>

    <!-- Spacer: RemoteViews refuses to inflate a generic android.view.View
         (only its own whitelisted view classes), so use an empty TextView. -->
    <TextView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Activity ring: sweep = % of session used, color = state. The number
         lives inside the ring instead of beside flat linear bars. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal">

        <ImageView
            android:id="@+id/widget_session_ring"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_gravity="center_horizontal" />

        <LinearLayout
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/widget_session_pct"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--"
                android:textColor="#F2F2F3"
                android:textSize="22sp"
                android:fontFamily="monospace"
                android:letterSpacing="-0.02" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="USED"
                android:textColor="#40F2F2F3"
                android:textSize="6.5sp"
                android:letterSpacing="0.1"
                android:layout_marginTop="-2dp" />

        </LinearLayout>

    </FrameLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="5h rolling limit"
        android:textColor="#40F2F2F3"
        android:textSize="8sp"
        android:gravity="center"
        android:layout_marginTop="6dp" />

    <!-- Spacer -->
    <TextView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Weekly footer -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="WEEKLY"
            android:textColor="#40F2F2F3"
            android:textSize="7.5sp"
            android:letterSpacing="0.08" />

        <TextView
            android:id="@+id/widget_weekly_pct"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--%"
            android:textColor="#B8C4F0"
            android:textSize="11sp"
            android:fontFamily="monospace" />

    </LinearLayout>

</LinearLayout>
