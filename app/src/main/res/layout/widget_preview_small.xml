<?xml version="1.0" encoding="utf-8"?>
<!-- Widget picker preview for the Session ring widget (sample values). Mirrors SmallWidget in SessionSenseWidgets.kt. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_preview_bg"
    android:orientation="vertical"
    android:padding="16dp">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:layout_width="72dp"
            android:layout_height="72dp">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/widget_preview_ring" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="42%"
                android:textColor="#F2F2F3"
                android:textSize="14sp"
                android:textStyle="bold" />
        </FrameLayout>
        <ImageView
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_gravity="end"
            android:src="@drawable/widget_preview_dot" />
    </FrameLayout>
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:text="2h 18m"
        android:textColor="#F2F2F3"
        android:textSize="26sp"
        android:textStyle="bold" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:text="left · resets 5:40 PM"
        android:textColor="#6EE7D0"
        android:textSize="11sp" />
</LinearLayout>
