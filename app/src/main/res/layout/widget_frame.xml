<?xml version="1.0" encoding="utf-8"?>
<!-- Every widget: the card (composed by Glance) goes in card; taps on it open the app. With several accounts, page_next
     covers the page dots on the right edge and switches the widget to the next account. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/card"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
    <FrameLayout
        android:id="@+id/page_next"
        android:layout_width="44dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:contentDescription="Next account"
        android:visibility="gone" />
</FrameLayout>
