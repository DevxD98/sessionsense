<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="13dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="CAFFEINE SATURATION"
        android:textColor="#52F2F2F3"
        android:textSize="6.5sp"
        android:letterSpacing="0.1"
        android:fontFamily="sans-serif-medium" />

    <!-- Spacer: RemoteViews refuses to inflate a generic android.view.View
         (only its own whitelisted view classes), so use an empty TextView. -->
    <TextView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- The cup + liquid + pearls + straw + lid are all drawn into one
         bitmap in Kotlin (Canvas), since RemoteViews can't host custom
         shapes directly — this is the same technique as the activity ring. -->
    <ImageView
        android:id="@+id/widget_boba_cup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal" />

    <!-- Spacer -->
    <TextView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/widget_boba_val"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="--%"
        android:textColor="#F2F2F3"
        android:textSize="13sp"
        android:fontFamily="monospace"
        android:gravity="center" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Remaining Limit"
        android:textColor="#40F2F2F3"
        android:textSize="6.5sp"
        android:letterSpacing="0.05"
        android:gravity="center"
        android:layout_marginTop="1dp" />

</LinearLayout>
